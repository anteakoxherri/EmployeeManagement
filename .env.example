# Copy to .env and fill every blank value. Never commit .env.
# Single-quote passwords containing $ or # so Compose treats them literally.

# SQL Server: at least 8 characters, with uppercase, lowercase, digits and symbols.
# Avoid double quotes in this value (it is quoted inside the connection string).
MSSQL_SA_PASSWORD=
SQL_DATABASE=EmployeeManagementDb

# JWT_KEY: at least 32 UTF-8 bytes; use an independently generated random value.
JWT_KEY=
JWT_ISSUER=EmployeeManagementAPI
JWT_AUDIENCE=EmployeeManagementClient

# Seeded only when this administrator does not already exist.
SEED_ADMIN_EMAIL=
# Identity requires uppercase, lowercase, a digit, a symbol, and at least 6 characters.
SEED_ADMIN_PASSWORD=

# Use a dedicated RabbitMQ user rather than guest for container-to-container access.
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=

FRONTEND_PORT=8080
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
